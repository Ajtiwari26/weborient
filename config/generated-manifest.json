  "knowledgeBase": [
    {
      "topic": "docs",
      "question": "Why do standard scripts fail on React controlled inputs, and how does WebOrient solve it?",
      "answer": "React overrides the instance input.value setter to track synthetic state. WebOrient calls Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(el, val) before dispatching bubbling InputEvent('input') and Event('change') events."
    },
    {
      "topic": "docs",
      "question": "Can WebOrient target elements inside Web Components / Open Shadow DOM?",
      "answer": "Yes. DOMScanner._querySelectorAllDeep() recursively traverses open el.shadowRoot trees when indexing and resolving targets."
    },
    {
      "topic": "pricing",
      "question": "How does the 14-day money-back guarantee work?",
      "answer": "If WebOrient doesn't measurably improve user engagement or form completion within 14 days, click cancel in your dashboard for an automatic 100% refund\u2014no questions asked."
    },
    {
      "topic": "pricing",
      "question": "What happens if our website exceeds our monthly voice minutes?",
      "answer": "Your widget never abruptly shuts off mid-conversation. Additional usage is billed at $0.015 per active voice minute, or you can switch tiers anytime."
    }
  ],
