{
  "name": "weborient",
  "version": "0.3.0",
  "description": "Session-Aware Voice Co-Browsing & Synchronized Salesperson Agent SDK featuring a Cubic Bézier Ghost Cursor, Cross-Page Memory, Multilingual Speech Sync, and Closed-Loop DOM Actuation.",
  "main": "src/sdk/weborient.js",
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "build": "node scripts/bundle.js",
    "crawl": "python3 src/crawler/generate_manifest.py testscript/ --output config/generated-manifest.json",
    "relay": "python3 src/relay/weborient_relay.py",
    "test:live": "python3 testscript/test_gemini38_live.py",
    "test:demo": "open testscript/test-demo.html"
  },
  "keywords": [
    "voice-agent",
    "ghost-cursor",
    "gemini-live",
    "salesperson-ai",
    "session-memory",
    "dom-interaction",
    "co-browsing"
  ],
