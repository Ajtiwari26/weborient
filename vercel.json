{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sdk/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/config/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sdk/v1/weborient.js",
      "destination": "/dist/weborient.bundle.js"
    },
    {
      "source": "/demo-shared.js",
      "destination": "/testscript/demo-shared.js"
    },
    {
      "source": "/deploymate-stacked-logo.svg",
      "destination": "/testscript/deploymate-stacked-logo.svg"
    },
    {
      "source": "/deploymate-full-logo.svg",
      "destination": "/testscript/deploymate-full-logo.svg"
    },
    {
      "source": "/favicon.png",
      "destination": "/testscript/favicon.png"
    },
    {
      "source": "/",
      "destination": "/testscript/test-demo.html"
    },
    {
      "source": "/test-demo.html",
      "destination": "/testscript/test-demo.html"
    },
    {
      "source": "/test-demo",
      "destination": "/testscript/test-demo.html"
    },
    {
      "source": "/dashboard.html",
      "destination": "/testscript/dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/testscript/dashboard.html"
    },
    {
      "source": "/features.html",
      "destination": "/testscript/features.html"
    },
    {
      "source": "/features",
      "destination": "/testscript/features.html"
    },
    {
      "source": "/pricing.html",
      "destination": "/testscript/pricing.html"
    },
    {
      "source": "/pricing",
      "destination": "/testscript/pricing.html"
    },
    {
      "source": "/docs.html",
      "destination": "/testscript/docs.html"
    },
    {
      "source": "/docs",
      "destination": "/testscript/docs.html"
    },
    {
      "source": "/contact.html",
      "destination": "/testscript/contact.html"
    },
    {
      "source": "/contact",
      "destination": "/testscript/contact.html"
    }
  ]
}
